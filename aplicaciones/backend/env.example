# ============================================
# C4A SaaS - Configuración de Variables de Entorno
# ============================================
# Copia este archivo como .env y configura los valores según tu entorno
# NUNCA commitees el archivo .env al repositorio
# ============================================

# --------------------------------------------
# CONFIGURACIÓN GENERAL
# --------------------------------------------
# Entorno: desarrollo | produccion
ENTORNO=produccion

# Debug: true | false (siempre false en producción)
DEBUG=false

# Habilitar middleware de seguridad
HABILITAR_SECURITY_MIDDLEWARE=true

# --------------------------------------------
# BASE DE DATOS (PostgreSQL)
# --------------------------------------------
# URL completa de conexión a PostgreSQL
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_db
# Ejemplo: postgresql+asyncpg://c4a_user:password123@localhost:5432/c4a_saas
URL_BASE_DATOS=postgresql+asyncpg://usuario:contraseña@localhost:5432/c4a_saas

# Requerir SSL para conexión a base de datos (true | false)
SSL_REQUERIDO=false

# --------------------------------------------
# REDIS
# --------------------------------------------
# URL de conexión a Redis
# Formato: redis://host:puerto/db
# Ejemplo: redis://localhost:6379/0
URL_REDIS=redis://localhost:6379/0

# Requerir SSL para Redis (true | false)
SSL_REDIS=false

# --------------------------------------------
# JWT Y AUTENTICACIÓN
# --------------------------------------------
# Algoritmo JWT (RS256 recomendado)
ALGORITMO_JWT=RS256

# Clave pública RSA para JWT (formato PEM completo)
# Generar con: openssl genrsa -out private_key.pem 2048
# Luego: openssl rsa -in private_key.pem -pubout -out public_key.pem
# Copiar el contenido completo incluyendo -----BEGIN PUBLIC KEY----- y -----END PUBLIC KEY-----
CLAVE_PUBLICA_JWT=-----BEGIN PUBLIC KEY-----
TU_CLAVE_PUBLICA_RSA_AQUI
-----END PUBLIC KEY-----

# Clave privada RSA para JWT (formato PEM completo)
# IMPORTANTE: Mantener esta clave segura y nunca exponerla
# Copiar el contenido completo incluyendo -----BEGIN PRIVATE KEY----- y -----END PRIVATE KEY-----
CLAVE_PRIVADA_JWT=-----BEGIN PRIVATE KEY-----
TU_CLAVE_PRIVADA_RSA_AQUI
-----END PRIVATE KEY-----

# Tiempo de expiración del token de acceso (en minutos)
TIEMPO_EXPIRACION_ACCESO=15

# Tiempo de expiración del token de refresco (en minutos, 7 días = 10080)
TIEMPO_EXPIRACION_REFRESCO=10080

# --------------------------------------------
# CIFRADO
# --------------------------------------------
# Clave maestra para cifrado de datos sensibles
# Debe ser una cadena segura de al menos 32 caracteres
# Generar con: openssl rand -hex 32
CLAVE_MAESTRA_CIFRADO=tu-clave-maestra-segura-de-al-menos-32-caracteres-aqui

# --------------------------------------------
# EMAIL Y NOTIFICACIONES
# --------------------------------------------
# Usuario de email para notificaciones
EMAIL_USER=tu-email@gmail.com

# Contraseña o app password de email
# Para Gmail, usar App Password: https://support.google.com/accounts/answer/185833
EMAIL_PASSWORD=tu-app-password-aqui

# Servidor SMTP
SERVIDOR_SMTP=smtp.gmail.com

# Puerto SMTP (587 para TLS, 465 para SSL)
PUERTO_SMTP=587

# Usuario SMTP (puede ser diferente de EMAIL_USER)
USUARIO_SMTP=tu-email@gmail.com

# Contraseña SMTP (puede ser diferente de EMAIL_PASSWORD)
CONTRASEÑA_SMTP=tu-app-password-aqui

# Email desde el cual se envían las notificaciones
EMAIL_DESDE=noreply@c4a.cl

# --------------------------------------------
# STRIPE (Pagos)
# --------------------------------------------
# Clave pública de Stripe (pk_test_... o pk_live_...)
STRIPE_CLAVE_PUBLICA=pk_test_tu_clave_publica_aqui

# Clave secreta de Stripe (sk_test_... o sk_live_...)
# IMPORTANTE: Mantener esta clave segura
STRIPE_CLAVE_SECRETA=sk_test_tu_clave_secreta_aqui

# Secreto del webhook de Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui

# --------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# --------------------------------------------
# Orígenes permitidos separados por comas
# En producción, especificar solo los dominios permitidos
# Ejemplo: https://c4a.cl,https://app.c4a.cl
# En desarrollo: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=https://c4a.cl,https://app.c4a.cl

# --------------------------------------------
# CONFIGURACIÓN DE DESARROLLO
# --------------------------------------------
# Saltar verificación de email (solo para desarrollo)
# En producción debe ser false
SALTAR_VERIFICACION_EMAIL=false

# Saltar webhooks de Stripe (solo para desarrollo)
# En producción debe ser false
SALTAR_WEBHOOKS_STRIPE=false

# Simular servicios externos (solo para desarrollo)
# En producción debe ser false
SIMULAR_SERVICIOS_EXTERNOS=false

# --------------------------------------------
# CONFIGURACIÓN CHILE (No requiere cambios)
# --------------------------------------------
PAIS_DEFAULT=CL
ZONA_HORARIA=America/Santiago
IDIOMA_DEFAULT=es_CL
MONEDA_DEFAULT=CLP

# --------------------------------------------
# PRECIOS EN CLP (centavos)
# --------------------------------------------
# Precio mensual plan PRO en centavos (32.000 CLP = 3200000)
PRECIO_PRO_MENSUAL=3200000

# Precio mensual plan Empresarial en centavos (240.000 CLP = 24000000)
PRECIO_EMPRESARIAL_MENSUAL=24000000

# --------------------------------------------
# LÍMITES POR NIVEL (No requiere cambios normalmente)
# --------------------------------------------
# Plan Gratuito
MAX_USUARIOS_GRATUITO=1
MAX_EVALUACIONES_GRATUITO=1
MAX_PREGUNTAS_GRATUITO=10
DIAS_RETENCION_GRATUITO=30
MAX_RECOMENDACIONES_GRATUITO=3
LIMITE_VELOCIDAD_GRATUITO=100

# Plan Pro
MAX_USUARIOS_PRO=10
MAX_EVALUACIONES_PRO=50
MAX_PREGUNTAS_PRO=50
DIAS_RETENCION_PRO=365
MAX_RECOMENDACIONES_PRO=15
LIMITE_VELOCIDAD_PRO=1000

# Plan Empresarial
MAX_USUARIOS_EMPRESARIAL=100
MAX_EVALUACIONES_EMPRESARIAL=1000
MAX_PREGUNTAS_EMPRESARIAL=100
DIAS_RETENCION_EMPRESARIAL=2555
LIMITE_VELOCIDAD_EMPRESARIAL=10000
MAX_RECOMENDACIONES_EMPRESARIAL=50

# --------------------------------------------
# ARCHIVOS Y UPLOADS
# --------------------------------------------
# Directorio para uploads
DIRECTORIO_UPLOADS=uploads

# Directorio para reportes
DIRECTORIO_REPORTES=reportes

# Tamaño máximo de archivo en bytes (10MB = 10485760)
MAX_TAMAÑO_ARCHIVO=10485760

