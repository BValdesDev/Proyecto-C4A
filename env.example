# Configuración de desarrollo para C4A SaaS
# Copia este archivo como .env y ajusta los valores según tu entorno

# Base de datos
POSTGRES_DB=c4a_saas
POSTGRES_USER=c4a_user
POSTGRES_PASSWORD=c4a_password

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=c4a-dev-secret-key-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Stripe (configura tus claves reales)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (configura tus credenciales reales)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Configuración de desarrollo
ENVIRONMENT=development
DEBUG=true
TELEMETRY_ENABLED=false
LOG_LEVEL=INFO

