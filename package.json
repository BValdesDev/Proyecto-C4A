{
  "name": "c4a-saas",
  "version": "1.0.0",
  "description": "Plataforma SaaS de evaluación de ciberseguridad para PyMEs chilenas",
  "main": "index.js",
  "scripts": {
    "dev": "docker-compose up -d",
    "dev:frontend": "cd aplicaciones/frontend && npm run dev",
    "dev:backend": "cd aplicaciones/backend && uvicorn app.main:app --reload",
    "build": "cd aplicaciones/frontend && npm run build",
    "test": "cd aplicaciones/frontend && npm run test",
    "test:e2e": "cd aplicaciones/frontend && npm run test:e2e",
    "lint": "cd aplicaciones/frontend && npm run lint",
    "lint:fix": "cd aplicaciones/frontend && npm run lint:fix",
    "type-check": "cd aplicaciones/frontend && npm run type-check",
    "install:all": "cd aplicaciones/frontend && npm install && cd ../backend && pip install -r requirements.txt",
    "clean": "docker-compose down -v && rm -rf node_modules aplicaciones/frontend/node_modules aplicaciones/backend/__pycache__",
    "logs": "docker-compose logs -f",
    "stop": "docker-compose down",
    "restart": "docker-compose restart",
    "db:migrate": "cd aplicaciones/backend && alembic upgrade head",
    "db:seed": "cd aplicaciones/backend && python scripts/seed_data.py",
    "db:reset": "cd aplicaciones/backend && alembic downgrade base && alembic upgrade head"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cherrera0001/c4a-autodiagnostico.git"
  },
  "keywords": [
    "ciberseguridad",
    "saas",
    "evaluacion",
    "pymes",
    "chile",
    "nist",
    "cobit",
    "react",
    "fastapi",
    "typescript",
    "tailwindcss"
  ],
  "author": "C4A SaaS Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cherrera0001/c4a-autodiagnostico/issues"
  },
  "homepage": "https://github.com/cherrera0001/c4a-autodiagnostico#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "workspaces": [
    "aplicaciones/frontend",
    "aplicaciones/backend"
  ],
  "volumes": {
    "postgres_data": {},
    "redis_data": {}
  },
  "networks": {
    "c4a_network": {
      "driver": "bridge"
    }
  }
}
